# Copy to .env (git-ignored) next to the docker-compose*.yml files and fill in real values.
# No credentials are committed to this repository; the config/docker/env/*.env files reference
# these variables and `docker compose` refuses to start if any of them is missing.
# Generate values with e.g. `openssl rand -base64 24`.

# Database superuser / Fineract tenant-store password (MariaDB root or PostgreSQL superuser)
FINERACT_DB_PASSWORD=
# Master password used to encrypt the per-tenant database credentials in the tenants store
FINERACT_MASTER_PASSWORD=
# Password of the TLS keystore configured via FINERACT_SERVER_SSL_KEY_STORE
FINERACT_SSL_KEY_STORE_PASSWORD=
